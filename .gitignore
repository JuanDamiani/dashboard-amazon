# ==================================
# PYTHON
# ==================================

__pycache__/
*.pyc
*.pyo

# Entornos virtuales
.venv/
venv/
env/

# ==================================
# VARIABLES SENSIBLES
# ==================================

.env
.env.*
!.env.example

# ==================================
# AIRFLOW LOGS
# ==================================

logs/*
!logs/.gitkeep

# ==================================
# DATASETS Y OUTPUTS
# ==================================

# Mantener estructura
!data/
!data/input/
!data/output/

# Ignorar outputs generados
data/output/*
!data/output/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/rejected/*
!data/rejected/.gitkeep

# Opcional:
# descomentá esto si NO quieren subir datasets
# data/input/*
# !data/input/.gitkeep

# ==================================
# EDITORES
# ==================================

.vscode/
.idea/

# ==================================
# SISTEMA
# ==================================

.DS_Store
Thumbs.db

# ==================================
# BASES / TEMPORALES
# ==================================

*.sqlite
*.db
*.log
