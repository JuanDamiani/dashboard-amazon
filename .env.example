# Puertos publicados en la maquina host
AIRFLOW_PORT=8080
METABASE_PORT=3000

# PostgreSQL de metadata de Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# PostgreSQL Data Warehouse
DWH_DB_USER=dwh
DWH_DB_PASSWORD=dwh123
DWH_DB_HOST=postgres-dwh
DWH_DB_PORT=5432
DWH_DB_NAME=amazon_dwh

# Conexion Airflow al Data Warehouse
# Si no se define, docker-compose.yml la construye desde DWH_DB_*.
# AIRFLOW_CONN_POSTGRES_DWH=postgres://dwh:dwh123@postgres-dwh:5432/amazon_dwh

# Conexion SQLAlchemy usada por los scripts Python.
# Si no se define, scripts/config.py la construye desde DWH_DB_*.
# DB_URL=postgresql+psycopg2://dwh:dwh123@postgres-dwh:5432/amazon_dwh

# PostgreSQL de Metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=metabase123
METABASE_DB_NAME=metabase

# Setup automatico de Metabase
METABASE_ADMIN_EMAIL=admin@local.test
METABASE_ADMIN_PASSWORD=AdminLocal2026!
METABASE_ADMIN_FIRST_NAME=Admin
METABASE_ADMIN_LAST_NAME=Local
METABASE_SITE_NAME=Amazon E-Commerce Dashboard
METABASE_DWH_NAME=Amazon DWH
METABASE_COLLECTION_NAME=Amazon E-Commerce
